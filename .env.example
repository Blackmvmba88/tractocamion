# Database
DATABASE_URL=postgresql://tractocamion:tractocamion_local_only@localhost:5432/tractocamion

# Server
PORT=3000
NODE_ENV=development
DB_LOG_SQL=false

# App Config
AUTO_REFRESH_INTERVAL=5000

# JWT Authentication
# Generate two different values with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_64_character_value
JWT_REFRESH_SECRET=replace_with_another_random_64_character_value
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15
CORS_ORIGIN=*
ALLOW_PUBLIC_REGISTRATION=false

# Business Configuration - Earnings
BASE_RATE_PER_HOUR=50
EFFICIENCY_BONUS_THRESHOLD=60
EFFICIENCY_BONUS=20

# Business Configuration - Performance
TARGET_CYCLE_TIME=55
EFFICIENCY_THRESHOLD=60

# Business Configuration - Alerts
FATIGUE_THRESHOLD_HOURS=8
DELAYED_CYCLE_THRESHOLD_HOURS=2
EXTENDED_REST_THRESHOLD_HOURS=4

# Pagination
DEFAULT_LIMIT=50
MAX_LIMIT=100
